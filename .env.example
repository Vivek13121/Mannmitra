# Environment Variables for MannMitra Deployment
# Copy this file to .env.local for local development
# Add these variables to your Netlify environment settings

# Supabase Configuration (Required)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Gemini AI API (Required for chat functionality)
VITE_GEMINI_API_KEY=your_gemini_api_key

# AssemblyAI API (Optional - for voice analysis feature)
VITE_ASSEMBLYAI_API_KEY=your_assemblyai_api_key

# Hugging Face API (Optional - if used for additional AI features)
VITE_HUGGING_FACE_API_KEY=your_huggingface_api_key